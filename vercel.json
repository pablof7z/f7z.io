{
  "rewrites": [
    {
      "source": "/ai-sdk/context-management/:path*",
      "destination": "https://context-management-webapp.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/nostr.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
