{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/nostr.json",
      "destination": "/well-known-nostr.json"
    },
    {
      "source": "/ai-sdk/context-management/:path*",
      "destination": "https://context-management-webapp.vercel.app/:path*"
    }
  ]
}
